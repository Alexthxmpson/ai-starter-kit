# ============================================================
# API keys for your command center.
# The setup wizard (setup/wizard.sh) or /onboard fills this in.
# Leave anything you do not use empty. NEVER commit this file.
# ============================================================

# --- Search (pick at least one) ---
TAVILY_API_KEY=            # free 1,000 credits/mo · https://app.tavily.com
PERPLEXITY_API_KEY=        # optional · https://www.perplexity.ai/settings/api
EXA_API_KEY=               # optional, semantic search · https://dashboard.exa.ai
FIRECRAWL_API_KEY=         # optional, scraping · https://firecrawl.dev

# --- Data ---
AIRTABLE_API_KEY=          # https://airtable.com/create/tokens (scopes: data.records read+write, schema.bases read)
SUPABASE_URL=              # optional · https://supabase.com → project → Settings → API
SUPABASE_ANON_KEY=

# --- AI models (optional: Claude Code itself uses your Claude login, not these) ---
GROQ_API_KEY=              # free, ultra-fast transcription · https://console.groq.com/keys
ANTHROPIC_API_KEY=         # only for building your own apps · https://console.anthropic.com
OPENAI_API_KEY=            # optional · https://platform.openai.com/api-keys
GEMINI_API_KEY=            # optional · https://aistudio.google.com/apikey

# --- Business connectors (optional) ---
FATHOM_API_KEY=            # meeting recordings · https://fathom.video → Settings → API
ELEVENLABS_API_KEY=        # voice generation · https://elevenlabs.io
GHL_API_KEY=               # GoHighLevel · Settings → API keys

# --- Alexander's client portal (consulting clients only; /ai-consulting asks for it) ---
AIC_PORTAL_TOKEN=          # 40-char token Alexander sends you; treat like a password
AIC_PORTAL_URL=            # leave empty (defaults to https://alexander-clients.vercel.app)
